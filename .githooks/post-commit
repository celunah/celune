#!/bin/bash

repository_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
if ! python "$repository_root/scripts/root.py"; then
    echo 'There was a problem updating the Celune root marker.' >&2
    echo 'Run scripts/root.py to update it manually.' >&2
else
    git -C "$repository_root" add -- .celune-root
fi
